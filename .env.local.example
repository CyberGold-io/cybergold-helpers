# Local Helpers development only. Canonical orchestration and service variables
# live in ../cybergold-ops. Copy to .env.local; never commit real secrets.
MAINNET_RPC_URL=https://ethereum.publicnode.com

# Optional direct-deployment overrides. Values here override
# config/deploy-config.json; CORE_DIAMOND_ADDRESS must resolve nonzero.
CORE_DIAMOND_ADDRESS=0x0000000000000000000000000000000000000000
HELPER_ADMIN=0x0000000000000000000000000000000000000000
HELPER_FEE_PPM=0
